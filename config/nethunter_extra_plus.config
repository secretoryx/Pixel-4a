# NetHunter TIER-2 advanced config fragment  (merge AFTER nethunter_extra.config)
# Pixel 4a 5G (bramble) · Linux 4.19. Extra capabilities beyond the core report.
# Some items carry risk/size/compat notes — see Advanced-Plus-Features.md.

# ===== more USB Wi-Fi injectors (in-tree mt76) =====
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7663U=m
CONFIG_MT7921U=m
# (out-of-tree 8814au / 8821cu / 88x2bu / 8188eus added via driver trees at build time)

# ===== virtual radios for AP/hostapd testing without hardware =====
CONFIG_MAC80211_HWSIM=m

# ===== eBPF / XDP (bettercap, modern packet tooling, tc-bpf) =====
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_XDP_SOCKETS=y
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m

# ===== full netfilter + ipset + QoS (advanced MITM/firewall/shaping) =====
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_TEE=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=m

# ===== tunneling / pivoting / VPN transports =====
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_NET_IPGRE=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_IPV6_GRE=m
CONFIG_L2TP=m
CONFIG_L2TP_V3=y
CONFIG_PPPOE=m
CONFIG_PPP_MPPE=m
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=m
CONFIG_TLS=m

# ===== filesystems (external drives, chroot images, forensics, mounts) =====
CONFIG_FUSE_FS=y            # use ntfs-3g / exfat-fuse from the chroot (4.19 has no in-tree ntfs3/exfat)
CONFIG_NTFS_FS=y            # read-only NTFS in-tree
CONFIG_CIFS=m               # mount SMB/Windows shares
CONFIG_NBD=m                # network block device
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_CRYPT=y           # LUKS encrypted volumes

# ===== containers / Docker on device (advanced) =====
CONFIG_USER_NS=y            # NOTE: widens attack surface (see report)
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_POSIX_MQUEUE=y

# ===== more USB gadget personalities =====
CONFIG_USB_CONFIGFS_F_UVC=y     # present as a webcam
CONFIG_USB_CONFIGFS_F_PRINTER=y # present as a printer
CONFIG_USB_CONFIGFS_F_UAC2=y    # present as a USB audio device
CONFIG_USB_CONFIGFS_F_TCM=y     # SCSI/iSCSI target gadget
CONFIG_USB_CONFIGFS_F_FS=y      # FunctionFS (custom gadgets)

# ===== HID / input depth (raw HID, virtual input injection) =====
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_UINPUT=y

# ===== crypto needed by dm-crypt / wireguard / kTLS =====
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CHACHA20POLY1305=m
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

# ===== research / debugging (size + attack-surface cost — optional) =====
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
