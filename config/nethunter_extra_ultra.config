# NetHunter TIER-3 "ultra" config fragment  (merge AFTER the plus fragment)
# Pixel 4a 5G (bramble) · Linux 4.19. Frontier capabilities. See Advanced-Plus-Features.md (tier-3 section).
# Caveated items (not in vanilla 4.19) are left COMMENTED with a note.

# ===== USB HOST device classes (use real peripherals via OTG) =====
# Mount USB flash drives / SSDs
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# External USB Ethernet / gigabit
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_RNDIS_HOST=m
# External USB 4G/LTE modems for out-of-band connectivity
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
# External USB webcam / sound card (recon, SDR audio)
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_SND_USB_AUDIO=m
# Connect to USB printers (host)
CONFIG_USB_PRINTER=m

# ===== NFC / RFID (libnfc, mfoc, ACR122U, PN533 readers) =====
CONFIG_NFC=y
CONFIG_NFC_DIGITAL=y
CONFIG_NFC_NCI=y
CONFIG_NFC_HCI=y
CONFIG_NFC_PN533=m
CONFIG_NFC_PN533_USB=m
CONFIG_NFC_PORT100=m

# ===== IEEE 802.15.4 / ZigBee / 6LoWPAN (IoT pentest, ATUSB) =====
CONFIG_IEEE802154=m
CONFIG_IEEE802154_SOCKET=m
CONFIG_MAC802154=m
CONFIG_IEEE802154_ATUSB=m
CONFIG_IEEE802154_FAKELB=m
CONFIG_6LOWPAN=m

# ===== Bluetooth LE + extras (btmon, gatttool, BLE recon) =====
CONFIG_BT_LE=y
CONFIG_BT_LEDS=y
CONFIG_BT_6LOWPAN=m
CONFIG_BT_HS=y

# ===== Wi-Fi reliability / debug =====
CONFIG_ATH9K_DYNACK=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# ===== exotic serial / PPP transports =====
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_SLIP=m
CONFIG_SLIP_COMPRESSED=y

# ===== removable-media filesystems =====
# Android 4.19 backported exFAT (staging) in some trees; enable if present:
CONFIG_STAGING=y
CONFIG_EXFAT_FS=y

# ===== research / forensics (opt-in; see risk notes) =====
CONFIG_CHECKPOINT_RESTORE=y   # CRIU process checkpoint/restore
CONFIG_USERFAULTFD=y
# CONFIG_PROC_KCORE=y          # RISK: exposes kernel memory image (forensics but a disclosure vector)
# CONFIG_KCOV=y                # kernel-coverage fuzzing; large size cost
# CONFIG_USB_RAW_GADGET=y      # Facedancer-style arbitrary USB emulation — NOT in vanilla 4.19 (5.7+); needs backport
